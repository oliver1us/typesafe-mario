OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
BACKEND=openrouter
MODEL=
# Optional full System One endpoint override, not a chat endpoint.
BASE_URL=
POLICY=typesafe
GAME_DISPLAY=dashboard
# Dashboard-only approximate action paths; not Jev forecasts or survival odds.
SHOW_TRAJECTORIES=true
# Virtual desktop and initial plain game window size (dashboard layout is fixed).
DISPLAY_WIDTH=1440
DISPLAY_HEIGHT=810
SAFETY_MODE=off
# Fractions: 0.8 means 80%, not a survival probability.
MIN_CONFIDENCE=0.8
DANGER_THRESHOLD=0.5
SAFETY_MARGIN_FRAMES=6
FRAMES_PER_DECISION=8
MAX_DECISIONS=2000
SEED=123
ENV_ID=SuperMarioBros-1-1-v0
# Host port; the container always uses 6080 with Compose.
NOVNC_PORT=6081
VNC_PASSWORD=mario
# Only for an Ollama/server build exposing /v1/systemone.
OLLAMA_HOST=http://host.docker.internal:11434
