# No APIs: set POLICY=heuristic and leave API keys blank.
BASE_URL="" # Blank: backend endpoint; prefer an explicit BACKEND when overriding.
POLICY=typesafe # typesafe (AI/provider) | heuristic (offline, no APIs).
GAME_DISPLAY=dashboard # dashboard | game | none (headless, no VNC/noVNC).

# Heuristic ignores provider/model/URL/credentials; BACKEND must still be a valid choice.
OPENROUTER_API_KEY="" # Required for POLICY=typesafe with BACKEND=openrouter.
TYPESAFE_API_KEY="" # Required for POLICY=typesafe with BACKEND=direct (no OpenRouter).
BACKEND=openrouter # auto | direct | openrouter | ollama; blank means openrouter, not offline.
MODEL="" # Blank: backend's default model (see README).

# Dashboard-only approximate action paths.
SHOW_TRAJECTORIES=true # true/1/yes/on | false/0/no/off.

# Virtual desktop and initial plain game window size (dashboard layout is fixed).
DISPLAY_WIDTH=1440
DISPLAY_HEIGHT=810
SAFETY_MODE=off # off | conservative (no survival guarantee).

# Fractions: 0.8 means 80%, not a survival probability.
MIN_CONFIDENCE=0.8
DANGER_THRESHOLD=0.5
SAFETY_MARGIN_FRAMES=6
FRAMES_PER_DECISION=8
MAX_DECISIONS=2000
SEED=123
ENV_ID=SuperMarioBros-1-1-v0

# Host port; the container always uses 6080 with Compose.
NOVNC_PORT=6080

# Localhost by default.
NOVNC_BIND_ADDRESS=127.0.0.1

# Build-time image user/group IDs 
MARIO_UID=1000
MARIO_GID=1000
VNC_PASSWORD=mario # Public default; local/trusted access only, no TLS.
# Only for an explicitly System One-compatible server, not stock Ollama/chat models.
# OLLAMA_API_KEY is an optional bearer token for this server.
OLLAMA_HOST=http://host.docker.internal:11434 # BACKEND=ollama host; /v1/systemone is appended.
